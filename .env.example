# Copy to .env (gitignored) and fill in. NEVER commit real keys.
# Alpaca PAPER keys only. Create them in the Alpaca dashboard under the Paper account.
# Alpaca keys cannot withdraw funds; still, never use live-account keys here.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true

# Optional
ALPHAVANTAGE_API_KEY=
# Alert channel (to be chosen by owner), e.g. ntfy topic, Telegram bot token/chat id, or SMTP settings
ALERT_NTFY_TOPIC=
